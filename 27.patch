+    static long[] removeValuesBefore(final long[] array, final long threshold) {
+        if (array == null || array.length == 0) {
+            return EMPTY_LONG_ARRAY;
+        }
+        int startIndex = 0;
+        while (startIndex < array.length && array[startIndex] < threshold) {
